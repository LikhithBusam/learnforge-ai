# AI Study Companion — Backend configuration (placeholders only; never commit real values)
# Copy to .env.development for local work. See docs/engineering/security-baseline.md
# and docs/engineering/local-development.md.

# --- Environment ---
APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 16 + pgvector; ADR-0013) ---
DATABASE_URL=postgresql+asyncpg://studycompanion:CHANGE_ME_DEV_PASSWORD@localhost:5432/studycompanion
# Runtime RLS role (non-superuser, non-BYPASSRLS) — REQUIRED for the app to serve.
# Generate via: python scripts/provision_runtime_role.py (after `alembic upgrade head`).
DATABASE_RUNTIME_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Redis (cache/broker/limits; ADR-0014; NOT a system of record) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (ADR-0016; provider behind StorageProvider abstraction) ---
# STORAGE_PROVIDER: "supabase" (cloud-first, ADR-0022), "minio" (local compose), or "" (auto)
STORAGE_PROVIDER=
# Supabase server-side secret key (service_role). NEVER expose to frontend/logs.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=studycompanion-dev
STORAGE_ACCESS_KEY_ID=CHANGE_ME_DEV_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_DEV_SECRET
STORAGE_REGION=us-east-1
STORAGE_PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500

# --- Auth (JWT RS256 keypair; ADR-0018) ---
# Generate a dev keypair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private_key.pem
#   openssl rsa -in jwt_private_key.pem -pubout -out jwt_public_key.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_DEV_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_DEV_KEY\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ISSUER=study-companion
JWT_AUDIENCE=study-companion-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Refresh cookie (HttpOnly; Secure; SameSite=Strict) - production MUST set true:
REFRESH_COOKIE_SECURE=false
# Admin bootstrap (operator CLI only; never an API):
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536

# --- AI provider roles (ADR-0015; never vendors in code; keys via secrets facility) ---
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER_REGISTRY=stub
AI_GENERATION_PROVIDER=stub
AI_GENERATION_MODEL=stub-generation
AI_GENERATION_API_KEY_REF=
AI_GENERATION_TIMEOUT_SECONDS=30
AI_GENERATION_MAX_TOKENS=1024
AI_GENERATION_TEMPERATURE=0.0
AI_GENERATION_FALLBACK_PROVIDER=stub
AI_GENERATION_FALLBACK_MODEL=stub-generation
AI_GENERATION_FALLBACK_API_KEY_REF=
AI_STRUCTURED_PROVIDER=stub
AI_STRUCTURED_MODEL=stub-structured
AI_STRUCTURED_API_KEY_REF=
AI_STRUCTURED_TIMEOUT_SECONDS=60
AI_STRUCTURED_TEMPERATURE=0.0
AI_EMBEDDING_PROVIDER=stub
AI_EMBEDDING_MODEL=stub-embedding
AI_EMBEDDING_API_KEY_REF=
AI_EMBEDDING_DIMENSIONS=8
AI_EMBEDDING_BATCH_SIZE=128
AI_RERANKER_PROVIDER=stub
AI_RERANKER_MODEL=stub-reranker
AI_RERANKER_API_KEY_REF=
AI_EVALUATION_PROVIDER=stub
AI_EVALUATION_MODEL=stub-evaluation
AI_EVALUATION_API_KEY_REF=
AI_VISION_PROVIDER=stub
AI_VISION_MODEL=stub-vision
AI_VISION_API_KEY_REF=
AI_USER_DAILY_TOKEN_BUDGET=1000000
AI_PRICE_TABLE_REF=config/prices-stub.json

# --- Retrieval policy (A-20; tuned later, never magic numbers) ---
RETRIEVAL_TOP_K=30
RETRIEVAL_RERANK_TO=6
RETRIEVAL_SUFFICIENCY_TAU=
RETRIEVAL_MIN_SUPPORTING_CHUNKS=2
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15
CONTEXT_TOKEN_BUDGET=6000

# --- Background work (Celery; ADR-0014) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WORKER_CONCURRENCY_DOCUMENTS=2
WORKER_CONCURRENCY_LEARNING=4

# --- Rate limits ---
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Observability (ADR-0020) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
TRACE_SAMPLE_RATE=1.0
